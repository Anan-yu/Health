COMPOSE_PROJECT_NAME=rayk-a1
# 基础镜像可按需改为企业或国内代理地址；默认保持官方镜像名
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
NGINX_IMAGE=nginx:1.27-alpine
MAVEN_IMAGE=docker.m.daocloud.io/library/maven:3.9.9-eclipse-temurin-21
JAVA_RUNTIME_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:21-jre-alpine
MYSQL_DATABASE=rayk_health
MYSQL_USER=rayk
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_password
REDIS_PASSWORD=change_redis_password
MINIO_ROOT_USER=rayk_minio
MINIO_ROOT_PASSWORD=change_minio_password
MINIO_BUCKET_REPORTS=rayk-reports
JWT_SECRET=change_to_a_long_random_secret_at_least_32_bytes
JWT_EXPIRE_SECONDS=604800
SPRING_PROFILES_ACTIVE=docker
RAYK_AI_BASE_URL=http://rayk-ai:8000
RAYK_AI_READ_TIMEOUT_SECONDS=600
RAYK_OCR_MODE=paddle
PADDLE_PDX_MODEL_SOURCE=BOS
# 阿里云 Qwen3.8-Flash 先识别 PDF 渲染页，失败页再用 Qwen3.5-OCR；本地 PDF/Paddle 最后兜底。
# 密钥只能放在未纳入版本控制的 .env 或部署平台密钥管理中。
QWEN_OCR_ENABLED=false
QWEN_OCR_API_KEY=
QWEN_OCR_WORKSPACE_ID=
QWEN_OCR_BASE_URL=
QWEN_OCR_MODEL=qwen3.8-flash
QWEN_OCR_FALLBACK_MODEL=qwen3.5-ocr
QWEN_OCR_TIMEOUT_SECONDS=180
QWEN_OCR_MAX_PIXELS=16000000
QWEN_OCR_MAX_PAGES=50
QWEN_OCR_CONCURRENCY=3
# 图片体检报告直接综合分析；签名图片地址只在服务间短时传递，不写入代码或日志。
QWEN_VISION_ENABLED=false
QWEN_VISION_API_KEY=
QWEN_VISION_WORKSPACE_ID=
QWEN_VISION_BASE_URL=
QWEN_VISION_MODEL=qwen3.8-flash
QWEN_VISION_TIMEOUT_SECONDS=120
QWEN_VISION_MAX_TOKENS=16000
QWEN_VISION_MAX_IMAGES=50
QWEN_VISION_MAX_IMAGE_BYTES=2000000
QWEN_VISION_MAX_TOTAL_IMAGE_BYTES=8000000
QWEN_VISION_MAX_IMAGE_PIXELS=12000000
QWEN_VISION_BATCH_SIZE=4
QWEN_VISION_BATCH_ATTEMPTS=2
QWEN_VISION_IMAGE_ANALYSIS_MAX_TOKENS=8000
# DeepSeek is optional. Keep the key empty in version-controlled files.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_TOKENS=16000
DEEPSEEK_MAX_ATTEMPTS=3
DEEPSEEK_RETRY_BACKOFF_SECONDS=1
DEEPSEEK_THINKING_ENABLED=false
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_PRESIGN_EXPIRY_SECONDS=600
WECHAT_APP_ID=wxf6f4549c8c962948
WECHAT_APP_SECRET=
WECHAT_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
WECHAT_MOCK_ENABLED=false
WECHAT_MOCK_OPENID=rayk-dev-openid
# 企业主体生产环境设为 true；本地 compose.dev 会覆盖为 false 以保留三角色调试。
WECHAT_PHONE_LOGIN_REQUIRED=true
# 仅用于兼容旧的 Mock 绑定路径；手机号登录模式下保持为空。
WECHAT_AUTO_BIND_USERNAME=
# Optional first-login bootstrap for the pre-registered platform administrator.
# Keep the real phone only in the deployment environment, never in Git.
WECHAT_PLATFORM_ADMIN_PHONE=
WECHAT_PLATFORM_ADMIN_USERNAME=admin
# 健康拍：密钥只能配置在 Java 服务端，禁止写入小程序源码。
HEALTH_SHOT_ENABLED=false
HEALTH_SHOT_APP_ID=
HEALTH_SHOT_KEY=
HEALTH_SHOT_API_BASE_URL=https://api-uat.utours.cn
HEALTH_SHOT_UPLOAD_PATH=/open-service/face-detect/upload-video
HEALTH_SHOT_ENVIRONMENT=UAT
HEALTH_SHOT_PLUGIN_PROVIDER=wx9ad841f52fa9bd7b
# 联调期可暂用 latest；正式提审前必须向健康拍索取并锁定正式版本号。
HEALTH_SHOT_PLUGIN_VERSION=latest
HEALTH_SHOT_PLUGIN_SERVER_URL=
# 腾讯云语音合成：密钥仅配置在本机 .env 或部署平台密钥管理中。
TENCENT_TTS_ENABLED=false
TENCENT_TTS_APP_ID=
TENCENT_TTS_SECRET_ID=
TENCENT_TTS_SECRET_KEY=
TENCENT_TTS_REGION=ap-guangzhou
TENCENT_TTS_FEMALE_VOICE_TYPE=601012
TENCENT_TTS_MALE_VOICE_TYPE=501005
TENCENT_TTS_SPEED=-1
TENCENT_TTS_VOLUME=0
TENCENT_TTS_SAMPLE_RATE=24000

# Customer membership (keep simulated in development; enable real payment only after merchant setup)
MEMBERSHIP_ENABLED=true
MEMBERSHIP_PAYMENT_ENABLED=false
MEMBERSHIP_FREE_AI_ASSESSMENT_TRIAL=3
MEMBERSHIP_FREE_AI_REPORT_TRIAL=3
MEMBERSHIP_FREE_AI_FOLLOWUP_TRIAL=1
MEMBERSHIP_FREE_HEALTH_SHOT_TRIAL=3
MEMBERSHIP_FREE_TTS_MEAL_TRIAL=3
MEMBERSHIP_FREE_TTS_SLEEP_TRIAL=3
# Development-only membership state switch; keep false outside compose.dev.yml.
MEMBERSHIP_DEVELOPMENT_MODE=false
# Frontend and server mall gates are disabled in production until product,
# fulfilment and payment materials are ready; enable both explicitly later.
MALL_ENABLED=false
MALL_PAYMENT_ENABLED=false
# WeChat Pay JSAPI (never commit real values; mount the private key through WECHAT_PAY_CERT_DIR)
WECHAT_PAY_APP_ID=
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechatpay/apiclient_key.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://your-domain.example.com/api/payments/wechat/notify
WECHAT_PAY_CERT_DIR=./secrets/wechatpay

# WeChat Mini Program virtual payment (short_series_goods; keep AppKeys out of Git)
WECHAT_VIRTUAL_APP_ID=wxf6f4549c8c962948
WECHAT_VIRTUAL_MERCHANT_ID=1116509042
WECHAT_VIRTUAL_OFFER_ID=1450618433
WECHAT_VIRTUAL_APP_KEY=
WECHAT_VIRTUAL_SANDBOX_APP_KEY=
WECHAT_VIRTUAL_ENV=0
WECHAT_VIRTUAL_MODE=short_series_goods
WECHAT_VIRTUAL_PRODUCT_ID=vip_year_399
WECHAT_VIRTUAL_NOTIFY_URL=https://xingxuyuan.com/api/payments/wechat/virtual/notify
# Token used by the mini-program message-push URL verification handshake.
WECHAT_VIRTUAL_PUSH_TOKEN=
# 金豆会员能力总开关；正式启用前必须同时配置支付商品、回调和收款能力。
GOLD_BEAN_ENABLED=false
GOLD_BEAN_DEVELOPMENT_MODE=false
GOLD_BEAN_PAYMENT_ENABLED=false
GOLD_BEAN_REGISTRATION_PRODUCT_ID=
GOLD_BEAN_REGISTRATION_FEE_CENT=100000
GOLD_BEAN_PLATFORM_REGISTRATION_FEE_CENT=100000
# Buyer virtual-payment surcharge; business/merchant-transfer amounts stay unchanged.
GOLD_BEAN_VIRTUAL_PAYMENT_SURCHARGE_PERCENT=12
# Separate published virtual product for referral-code registration (must match its backend price).
GOLD_BEAN_REFERRAL_REGISTRATION_PRODUCT_ID=
GOLD_BEAN_PRODUCT_ID=gold_bean
GOLD_BEAN_TRADE_PAYMENT_ENABLED=false
GOLD_BEAN_TRADE_TRANSFER_SCENE_ID=
GOLD_BEAN_TRADE_TRANSFER_NOTIFY_URL=
GOLD_BEAN_TRADE_TRANSFER_USER_RECV_PERCEPTION=劳务报酬
GOLD_BEAN_TRADE_TRANSFER_JOB_TYPE=金豆交易服务
GOLD_BEAN_TRADE_TRANSFER_REWARD_DESCRIPTION=金豆交易结算
GOLD_BEAN_TRADE_SETTLEMENT_RETRY_SECONDS=30
GOLD_BEAN_REGISTRATION_REFERRAL_TRANSFER_USER_RECV_PERCEPTION=劳务报酬
GOLD_BEAN_REGISTRATION_REFERRAL_TRANSFER_JOB_TYPE=推荐注册服务
GOLD_BEAN_REGISTRATION_REFERRAL_TRANSFER_REWARD_DESCRIPTION=推荐注册服务报酬
GOLD_BEAN_REGISTRATION_REFERRAL_AUTHORIZATION_NOTIFY_URL=https://your-domain.example.com/api/payments/wechat/merchant-transfer/authorization-notify
# Nightly generation of due health tree-hole seven-day summaries (Asia/Shanghai).
RAYK_HEALTH_TREE_HOLE_FEEDBACK_CRON=0 15 2 * * *
RAYK_DEVELOPMENT_LOGIN_ENABLED=false
JAVA_PORT=8080
AI_PORT=8000
NGINX_PORT=8088
MYSQL_PORT=3307
REDIS_PORT=6380
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
RAYK_BACKUP_DIR=E:\\DockerData\\RayKA1\\backups\\mysql
