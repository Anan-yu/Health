COMPOSE_PROJECT_NAME=rayk-a1
# 基础镜像可按需改为企业或国内代理地址；默认保持官方镜像名
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
NGINX_IMAGE=nginx:1.27-alpine
MAVEN_IMAGE=docker.m.daocloud.io/library/maven:3.9.9-eclipse-temurin-21
JAVA_RUNTIME_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:21-jre-alpine
MYSQL_DATABASE=rayk_health
MYSQL_USER=rayk
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_password
REDIS_PASSWORD=change_redis_password
MINIO_ROOT_USER=rayk_minio
MINIO_ROOT_PASSWORD=change_minio_password
MINIO_BUCKET_REPORTS=rayk-reports
JWT_SECRET=change_to_a_long_random_secret_at_least_32_bytes
JWT_EXPIRE_SECONDS=7200
SPRING_PROFILES_ACTIVE=docker
RAYK_AI_BASE_URL=http://rayk-ai:8000
RAYK_AI_READ_TIMEOUT_SECONDS=300
RAYK_OCR_MODE=paddle
PADDLE_PDX_MODEL_SOURCE=BOS
# 阿里云 Qwen3.5-OCR 为主识别，本地 Paddle/PDF 解析负责校验与兜底。
# 密钥只能放在未纳入版本控制的 .env 或部署平台密钥管理中。
QWEN_OCR_ENABLED=false
QWEN_OCR_API_KEY=
QWEN_OCR_WORKSPACE_ID=
QWEN_OCR_BASE_URL=
QWEN_OCR_MODEL=qwen3.5-ocr
QWEN_OCR_TIMEOUT_SECONDS=180
QWEN_OCR_MAX_PIXELS=16000000
QWEN_OCR_MAX_PAGES=50
QWEN_OCR_CONCURRENCY=3
# DeepSeek is optional. Keep the key empty in version-controlled files.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_TOKENS=393216
DEEPSEEK_THINKING_ENABLED=false
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_PRESIGN_EXPIRY_SECONDS=600
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
WECHAT_MOCK_ENABLED=true
WECHAT_MOCK_OPENID=rayk-dev-openid
# 仅用于显式模拟首次绑定；正常开发和生产均应保持为空。
WECHAT_AUTO_BIND_USERNAME=
# 健康拍：密钥只能配置在 Java 服务端，禁止写入小程序源码。
HEALTH_SHOT_ENABLED=false
HEALTH_SHOT_APP_ID=
HEALTH_SHOT_KEY=
HEALTH_SHOT_API_BASE_URL=https://api-uat.utours.cn
HEALTH_SHOT_UPLOAD_PATH=/open-service/face-detect/upload-video
HEALTH_SHOT_ENVIRONMENT=UAT
HEALTH_SHOT_PLUGIN_PROVIDER=wx9ad841f52fa9bd7b
# 联调期可暂用 latest；正式提审前必须向健康拍索取并锁定正式版本号。
HEALTH_SHOT_PLUGIN_VERSION=latest
HEALTH_SHOT_PLUGIN_SERVER_URL=
# 腾讯云语音合成：密钥仅配置在本机 .env 或部署平台密钥管理中。
TENCENT_TTS_ENABLED=false
TENCENT_TTS_APP_ID=
TENCENT_TTS_SECRET_ID=
TENCENT_TTS_SECRET_KEY=
TENCENT_TTS_REGION=ap-guangzhou
TENCENT_TTS_FEMALE_VOICE_TYPE=502001
TENCENT_TTS_MALE_VOICE_TYPE=602004
TENCENT_TTS_SPEED=-1
TENCENT_TTS_VOLUME=0
TENCENT_TTS_SAMPLE_RATE=24000
RAYK_DEVELOPMENT_LOGIN_ENABLED=false
JAVA_PORT=8080
AI_PORT=8000
NGINX_PORT=8088
MYSQL_PORT=3307
REDIS_PORT=6380
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
RAYK_BACKUP_DIR=E:\\DockerData\\RayKA1\\backups\\mysql
