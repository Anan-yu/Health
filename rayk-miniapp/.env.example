# H5 本地开发可留空使用同源代理；微信真机调试必须填写电脑当前局域网地址，例如 http://192.168.0.100:8088
VITE_API_BASE_URL=
# 正式构建请在未提交的 .env.production 中设置为 https://xingxuyuan.com
VITE_USE_MOCK=false
# 仅本机开发模式开启；正式发布必须保持 false
VITE_ENABLE_DEVELOPMENT_LOGIN=false
# 企业主体正式包应设为 true；本地开发可按后端 mock 配置选择是否开启
VITE_WECHAT_PHONE_LOGIN=true
# 首页视频功能开关；材料准备好并完成域名白名单后才设为 true
VITE_HOME_VIDEO_ENABLED=false
# 首页视频直链（必须使用 HTTPS；微信小程序还需将域名加入业务域名白名单）
VITE_HOME_VIDEO_URL=
# 可选：首页视频封面图直链（必须使用 HTTPS）
VITE_HOME_VIDEO_POSTER=
# 实物商城前端入口开关；商品、订单和支付代码保留，材料准备好后再设为 true
VITE_MALL_ENABLED=false
